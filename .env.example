# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored and must never be committed.

# OpenAI API key — used server-side only (never exposed to the overlay).
OPENAI_API_KEY=sk-your-key-here

# Optional: override the default OpenAI models (see memory.md defaults).
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# ── Interview auto-detection (smart question detection + answering) ───────────
# All optional. These override the "interview" block in config.json, which in
# turn overrides the built-in defaults in interview_config.py.
#
# INTERVIEW_CONFIDENCE_THRESHOLD=0.6    # 0..1; below this we don't auto-answer
# INTERVIEW_EOU_MS=700                  # end-of-utterance window (500-1000 ms)
# INTERVIEW_MIN_CHARS=6                 # min length (short valid Qs still pass)
# INTERVIEW_ANSWER_TIMEOUT_S=45         # per-answer generation timeout (sec)
# INTERVIEW_MAX_HISTORY_TURNS=40        # per-session conversation history cap
# INTERVIEW_CHAT_MODEL=                 # blank -> ai.py default (gpt-4o-mini)
# INTERVIEW_TEMPERATURE=0.3
# INTERVIEW_STREAMING=true              # stream answer chunks when supported
# INTERVIEW_DUP_WINDOW_S=120            # suppress repeat questions within window
# INTERVIEW_MAX_CONCURRENT=4            # global cap on in-flight LLM answers
# INTERVIEW_USE_LLM_CLASSIFIER=true     # LLM confirms ambiguous detections
# INTERVIEW_LLM_CLASSIFIER_MODEL=       # blank -> ai.py default
#
# Default language. English is the default; answers are generated in this
# language and the frontend should start sessions with it unless the user picks
# another supported language. Unknown values fall back to English.
# INTERVIEW_DEFAULT_LANGUAGE=en         # base language code (e.g. en)
# INTERVIEW_SPEECH_LOCALE=en-IN         # preferred STT locale (Indian English)
