    "temperature":                  0.3,
    "streaming":                    true,
    "duplicateWindowS":             120,
    "maxConcurrentGenerations":     4,
    "useLlmClassifier":             true,
    "llmClassifierModel":           null,
    "defaultLanguage":              "en",
    "defaultSpeechLocale":          "en-IN"
  }
}
